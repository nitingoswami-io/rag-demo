#!/bin/sh
# Blocks commits that include real env files or anything that looks like an API key.
fail=0

envs=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env(\.|$)' | grep -vE '\.example$')
if [ -n "$envs" ]; then
  echo "pre-commit: refusing to commit env files:"; echo "$envs" | sed 's/^/  /'
  fail=1
fi

pattern='sk-(proj-)?[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  if git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -qE "$pattern"; then
    echo "pre-commit: $f looks like it contains a secret (value not shown)."
    fail=1
  fi
done

[ $fail -eq 0 ] || { echo "Remove the secret (or unstage the file) and commit again."; exit 1; }
