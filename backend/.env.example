OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Models (optional). Changing EMBEDDING_MODEL needs a re-index: the stored
# vectors were made with the old model (docker compose down -v, then restart).
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Demo safety. Off by default: visitors can only query the sample knowledge bases.
# Set to true on your own machine to upload and delete your own files.
ALLOW_UPLOADS=false
MAX_UPLOAD_MB=5
CHAT_PER_MINUTE=20

# Deployment (Railway). Comma-separated browser origins allowed to call the API.
# ALLOWED_ORIGINS=https://your-app.vercel.app
# TRUST_PROXY=true
# GLOBAL_CHAT_PER_MINUTE=120
# Supabase: use the Session pooler URI (IPv4, port 5432), not the transaction pooler (6543).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
